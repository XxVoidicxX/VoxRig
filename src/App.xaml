<Application x:Class="VoxRig.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0D12"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#131720"/>
        <SolidColorBrush x:Key="CardBrush" Color="#171C26"/>
        <SolidColorBrush x:Key="LineBrush" Color="#252B37"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8ECF4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A93A6"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Application.Resources>
</Application>
