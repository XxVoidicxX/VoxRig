<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoxRig</AssemblyName>
    <RootNamespace>VoxRig</RootNamespace>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>VoxRig</Product>
    <AssemblyTitle>VoxRig</AssemblyTitle>
    <Description>Live mic effects rack for virtual cables</Description>
    <Copyright>Copyright (c) 2026 XxVoidicxX</Copyright>
    <ApplicationIcon>..\assets\VoxRig.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\VoxRig.ico" Link="VoxRig.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
